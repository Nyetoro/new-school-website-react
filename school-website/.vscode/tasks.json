{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install all dependencies",
      "type": "shell",
      "command": "cd backend && npm install && cd ../frontend && npm install",
      "problemMatcher": []
    },
    {
      "label": "Seed database",
      "type": "shell",
      "command": "npm run seed",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "▶ Start Website (both servers)",
      "dependsOn": ["Backend: dev server", "Frontend: dev server"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
